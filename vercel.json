{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "blog-site": {
      "root": "blog-site",
      "framework": "astro"
    },
    "consumer-prices-core": {
      "root": "consumer-prices-core",
      "runtime": "container"
    },
    "verification-desk": {
      "root": "demos/verification-desk",
      "runtime": "node"
    },
    "pro-test": {
      "root": "pro-test",
      "framework": "vite"
    },
    "python": {
      "root": "sdk/python",
      "runtime": "python"
    },
    "src-tauri": {
      "root": "src-tauri",
      "runtime": "rust"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}