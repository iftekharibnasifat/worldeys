
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite"
    },
    "blog-site": {
      "root": "blog-site",
      "framework": "astro"
    },
    "consumer-prices-core": {
      "root": "consumer-prices-core",
      "runtime": "container"
    },
    "verification-desk": {
      "root": "demos/verification-desk",
      "entrypoint": "server.mjs"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
